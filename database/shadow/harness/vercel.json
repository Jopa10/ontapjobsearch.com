{
  "framework": null,
  "buildCommand": "node measure-retention.mjs",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "outputDirectory": "retention-dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
